# Copy to .env (never commit .env). Every value here is read by the containers; the API and the worker never log them.

# Database password (local compose only; the DB is not published outside the compose network).
POSTGRES_PASSWORD=change-me-local

# Optional: register your own owner key instead of having `init` print a new one (pgate_ + 40+ URL-safe chars).
# POSTGATE_OWNER_KEY=

# Default time zone for wall-clock schedule input (IANA name).
POSTGATE_DEFAULT_TIMEZONE=UTC

# Instagram and Facebook download media from a URL. Set the public https base that reaches this API's /media/ route
# (e.g. a reverse proxy or tunnel you control) and a random secret (>= 16 chars) for the signed, short-lived links.
# POSTGATE_PUBLIC_URL=https://media.example.com
# POSTGATE_MEDIA_URL_SECRET=

# Channel tokens: one variable per channel, named whatever you like; `postgate channel add --token-env NAME`
# stores only the NAME. A value is a bare access token or a JSON token set from `postgate oauth`.
# LINKEDIN_MEMBER_TOKEN=
# LINKEDIN_PAGE_TOKEN=
# FACEBOOK_PAGE_TOKEN=
# INSTAGRAM_TOKEN=
# YOUTUBE_TOKEN=
# X_TOKEN=

# App credentials, only needed to refresh tokens (YouTube, X, Instagram, LinkedIn Page) and for `postgate oauth`.
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# META_APP_ID=
# META_APP_SECRET=
# INSTAGRAM_APP_ID=
# INSTAGRAM_APP_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# X_CLIENT_ID=
# X_CLIENT_SECRET=

# REHEARSAL ONLY: send every platform call to a local stand-in instead of the real networks.
# POSTGATE_STANDIN_URL=http://127.0.0.1:8790

# AI video (HeyGen). The worker reads the key by this NAME; it is never stored in the database.
# HEYGEN_API_TOKEN=
